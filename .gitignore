# Python caches and local environments
__pycache__/
*.py[cod]
*.egg-info/
.coverage
.coverage.*
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.venv/
venv/

# Editors and operating-system metadata
.DS_Store
Thumbs.db
