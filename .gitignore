config/models.json
config/hardware.json
config/*.local.json
config/*.private.json
*.key
*.p12
*.pfx
*.pem

# Generated and raw benchmark material
artifacts/*
!artifacts/.gitkeep
reports/
results/
runs/
*.log
*.pcap
*.pcapng

# Build output
build/
dist/
