{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leaderboard-submission.schema.json",
  "title": "Local Inference Test Bench leaderboard submission",
  "description": "One closed, minimized, self-reported result for one registered public benchmark suite and one public model artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "suite_version",
    "profile",
    "measurement_period",
    "validity",
    "measurement_conditions",
    "hardware",
    "runtime",
    "model",
    "settings",
    "cases",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "suite_version": {
      "$ref": "#/$defs/suiteVersion"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "measurement_period": {
      "$ref": "#/$defs/measurementPeriod"
    },
    "validity": {
      "$ref": "#/$defs/publicValidity"
    },
    "measurement_conditions": {
      "$ref": "#/$defs/measurementConditions"
    },
    "determinism": {
      "$ref": "#/$defs/determinism"
    },
    "hardware": {
      "$ref": "hardware-descriptor.schema.json#/$defs/hardware"
    },
    "runtime": {
      "$ref": "hardware-descriptor.schema.json#/$defs/runtime"
    },
    "runtime_configuration": {
      "$ref": "hardware-descriptor.schema.json#/$defs/runtimeConfiguration"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "settings": {
      "$ref": "#/$defs/settings"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "$ref": "#/$defs/caseResult"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    }
  },
  "$defs": {
    "publicText200": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[ -~]+$",
      "description": "Visible-ASCII artifact identity text; canonical validators additionally reject identifiers, URLs, network shapes, and reviewer-directed content."
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "suiteVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "measurementPeriod": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "modelDisplayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[ -~]+$"
    },
    "modelSource": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[ -~]+$"
    },
    "modelPrecision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[ -~]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "source",
        "precision",
        "declared_context_tokens"
      ],
      "properties": {
        "display_name": {
          "$ref": "#/$defs/modelDisplayName"
        },
        "source": {
          "$ref": "#/$defs/modelSource"
        },
        "revision": {
          "$ref": "#/$defs/publicText200"
        },
        "digest": {
          "$ref": "#/$defs/publicText200"
        },
        "precision": {
          "$ref": "#/$defs/modelPrecision"
        },
        "declared_context_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "oneOf": [
        {
          "required": [
            "revision"
          ],
          "not": {
            "required": [
              "digest"
            ]
          }
        },
        {
          "required": [
            "digest"
          ],
          "not": {
            "required": [
              "revision"
            ]
          }
        }
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_p",
        "max_output_tokens",
        "seed"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "reasoning_effort": {
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        }
      }
    },
    "publicValidity": {
      "enum": [
        "clean",
        "nonquiescent",
        "degraded_midrun"
      ]
    },
    "measurementCategory": {
      "enum": [
        "memory_pressure",
        "thermal",
        "sustained_load",
        "swap",
        "resident_models"
      ]
    },
    "measurementSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "categories"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "within_thresholds",
            "threshold_crossed"
          ]
        },
        "categories": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/measurementCategory"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "within_thresholds"
            },
            "categories": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "threshold_crossed"
            },
            "categories": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "measurementConditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre",
        "post",
        "hard_threshold_crossed"
      ],
      "properties": {
        "pre": {
          "$ref": "#/$defs/measurementSample"
        },
        "post": {
          "$ref": "#/$defs/measurementSample"
        },
        "hard_threshold_crossed": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "hard_threshold_crossed": {
              "const": false
            },
            "pre": {
              "properties": {
                "outcome": {
                  "const": "within_thresholds"
                }
              }
            },
            "post": {
              "properties": {
                "outcome": {
                  "const": "within_thresholds"
                }
              }
            }
          }
        },
        {
          "properties": {
            "hard_threshold_crossed": {
              "const": true
            },
            "pre": {
              "properties": {
                "outcome": {
                  "const": "threshold_crossed"
                }
              }
            },
            "post": {
              "properties": {
                "outcome": {
                  "const": "within_thresholds"
                }
              }
            }
          }
        },
        {
          "properties": {
            "hard_threshold_crossed": {
              "const": true
            },
            "pre": {
              "properties": {
                "outcome": {
                  "const": "within_thresholds"
                }
              }
            },
            "post": {
              "properties": {
                "outcome": {
                  "const": "threshold_crossed"
                }
              }
            }
          }
        },
        {
          "properties": {
            "hard_threshold_crossed": {
              "const": true
            },
            "pre": {
              "properties": {
                "outcome": {
                  "const": "threshold_crossed"
                }
              }
            },
            "post": {
              "properties": {
                "outcome": {
                  "const": "threshold_crossed"
                }
              }
            }
          }
        }
      ]
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_runs",
        "semantic_pass_rate",
        "envelope_class_stable",
        "finish_reason_stable",
        "fingerprint_stable",
        "verdict"
      ],
      "properties": {
        "n_runs": {
          "type": "integer",
          "minimum": 3,
          "maximum": 5
        },
        "semantic_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "envelope_class_stable": {
          "type": "boolean"
        },
        "finish_reason_stable": {
          "type": "boolean"
        },
        "fingerprint_stable": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "stable",
            "warning",
            "blocking_instability"
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "pass",
        "semantic_only",
        "format_only",
        "fail",
        "not_scored",
        "not_applicable"
      ]
    },
    "route": {
      "enum": [
        "direct_response",
        "read_only_tool",
        "safe_refusal",
        "unsafe_mutation",
        "unexpected_tool",
        "unrecognized",
        "not_applicable"
      ]
    },
    "termination": {
      "enum": [
        "completed",
        "tool_call",
        "filtered",
        "cancelled",
        "output_budget",
        "context_window",
        "length_unknown",
        "reasoning_only",
        "unknown",
        "other",
        "timeout",
        "network_error",
        "authentication",
        "rate_limited",
        "server_error",
        "request_rejected",
        "invalid_json",
        "protocol_error",
        "response_too_large",
        "http_error",
        "not_applicable"
      ]
    },
    "capability": {
      "enum": [
        "structured_output",
        "coding",
        "agent_tool_use",
        "cyber_triage",
        "safety_boundary"
      ]
    },
    "modality": {
      "enum": [
        "text",
        "vision"
      ]
    },
    "caseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "capability",
        "modality",
        "outcome",
        "route",
        "termination"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "capability": {
          "$ref": "#/$defs/capability"
        },
        "modality": {
          "$ref": "#/$defs/modality"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "termination": {
          "$ref": "#/$defs/termination"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "not_applicable"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "route": {
                "const": "not_applicable"
              },
              "termination": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "route": {
                "const": "not_applicable"
              }
            },
            "required": [
              "route"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_applicable"
              },
              "termination": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "termination": {
                "const": "not_applicable"
              }
            },
            "required": [
              "termination"
            ]
          },
          "then": {
            "properties": {
              "outcome": {
                "const": "not_applicable"
              },
              "route": {
                "const": "not_applicable"
              }
            }
          }
        }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "semantic_pass_count",
        "exact_format_pass_count",
        "scored_case_count",
        "usage_coverage_cases",
        "latency_ms_mean",
        "completion_tokens_per_second"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "semantic_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "exact_format_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scored_case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "usage_coverage_cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "latency_ms_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "completion_tokens_per_second": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$comment": "Suite membership, ordered case identity and taxonomy, case-count arithmetic, at least one scored public case, validity derivation, future-period rejection, canonical category order, determinism-rate arithmetic, digest verification, numeric precision, and public deny rules are enforced in lockstep by the Python and browser validators. Numeric completion_tokens_per_second requires usage_coverage_cases to equal scored_case_count; null remains valid when token usage is incomplete or unavailable. No suite length is embedded in this portable schema; validation resolves it through the versioned suite registry. Decimal precision remains outside the portable schema because binary floating-point implementations disagree on fractional multipleOf values."
}
