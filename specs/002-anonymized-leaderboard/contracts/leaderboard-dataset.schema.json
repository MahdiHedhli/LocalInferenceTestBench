{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leaderboard-dataset.schema.json",
  "title": "Local Inference Test Bench leaderboard dataset",
  "description": "The deterministic logical dataset built from accepted submissions, including an explicit retained-1.0 migration branch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/legacyMonolithEntry"
            }
          }
        }
      },
      "else": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/versionedEntry"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "legacyMonolithEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "submission_id",
        "suite_version",
        "profile",
        "hardware",
        "runtime",
        "model",
        "settings",
        "metrics"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "submission_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite_version": {
          "const": "1.0"
        },
        "profile": {
          "const": "standard"
        },
        "hardware": {
          "$ref": "hardware-descriptor.schema.json#/$defs/hardware"
        },
        "runtime": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtime"
        },
        "runtime_configuration": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtimeConfiguration"
        },
        "model": {
          "$ref": "leaderboard-submission-v1.0.schema.json#/$defs/model"
        },
        "settings": {
          "$ref": "leaderboard-submission-v1.0.schema.json#/$defs/settings"
        },
        "metrics": {
          "$ref": "#/$defs/legacyLeaderboardMetrics"
        }
      }
    },
    "versionedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "submission_schema_version",
        "submission_id",
        "suite_version",
        "profile",
        "validity",
        "measurement_period",
        "measurement_conditions",
        "hardware",
        "runtime",
        "model",
        "settings",
        "metrics"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "submission_schema_version": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "submission_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite_version": {
          "$ref": "leaderboard-submission.schema.json#/$defs/suiteVersion"
        },
        "profile": {
          "$ref": "leaderboard-submission.schema.json#/$defs/profile"
        },
        "validity": {
          "enum": [
            "clean",
            "nonquiescent",
            "degraded_midrun",
            "legacy_unreported"
          ]
        },
        "measurement_period": {
          "oneOf": [
            {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementPeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_conditions": {
          "oneOf": [
            {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementConditions"
            },
            {
              "type": "null"
            }
          ]
        },
        "determinism": {
          "$ref": "leaderboard-submission.schema.json#/$defs/determinism"
        },
        "hardware": {
          "$ref": "hardware-descriptor.schema.json#/$defs/hardware"
        },
        "runtime": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtime"
        },
        "runtime_configuration": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtimeConfiguration"
        },
        "model": {
          "$ref": "leaderboard-submission.schema.json#/$defs/model"
        },
        "settings": {
          "$ref": "leaderboard-submission.schema.json#/$defs/settings"
        },
        "metrics": {
          "$ref": "#/$defs/leaderboardMetrics"
        }
      },
      "oneOf": [
        {
          "properties": {
            "submission_schema_version": {
              "const": "1.0"
            },
            "suite_version": {
              "const": "1.0"
            },
            "profile": {
              "const": "standard"
            },
            "validity": {
              "const": "legacy_unreported"
            },
            "measurement_period": {
              "type": "null"
            },
            "measurement_conditions": {
              "type": "null"
            }
          },
          "not": {
            "required": [
              "determinism"
            ]
          }
        },
        {
          "properties": {
            "submission_schema_version": {
              "const": "1.1"
            },
            "validity": {
              "$ref": "leaderboard-submission.schema.json#/$defs/publicValidity"
            },
            "measurement_period": {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementPeriod"
            },
            "measurement_conditions": {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementConditions"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "standard"
              },
              "suite_version": {
                "const": "1.0"
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "metrics": {
                  "properties": {
                    "case_count": {
                      "const": 5
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "metrics": {
                  "properties": {
                    "latency_ms_mean": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "metrics": {
                  "properties": {
                    "usage_coverage_cases": {
                      "const": 0
                    },
                    "latency_ms_mean": {
                      "type": "null"
                    },
                    "completion_tokens_per_second": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "legacyLeaderboardMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "semantic_pass_count",
        "exact_format_pass_count",
        "scored_case_count",
        "usage_coverage_cases",
        "latency_ms_mean",
        "completion_tokens_per_second",
        "semantic_score_percent",
        "exact_format_score_percent"
      ],
      "properties": {
        "case_count": {
          "const": 5
        },
        "semantic_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "exact_format_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scored_case_count": {
          "const": 5
        },
        "usage_coverage_cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "latency_ms_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "completion_tokens_per_second": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "exact_format_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "completion_tokens_per_second": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "usage_coverage_cases": {
                "const": 5
              }
            }
          }
        }
      ]
    },
    "leaderboardMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "semantic_pass_count",
        "exact_format_pass_count",
        "scored_case_count",
        "usage_coverage_cases",
        "latency_ms_mean",
        "completion_tokens_per_second",
        "semantic_score_percent",
        "exact_format_score_percent"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "semantic_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "exact_format_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scored_case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "usage_coverage_cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "latency_ms_mean": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_tokens_per_second": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "exact_format_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "latency_ms_mean": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "usage_coverage_cases": {
                "const": 0
              },
              "completion_tokens_per_second": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "The logical 1.0 branch preserves the original unannotated monolith byte contract. A logical 1.1 dataset requires every row to declare its source submission schema: retained 1.0 rows use legacy_unreported with null measurement evidence, while 1.1 rows carry measured categorical validity. The Python builder is authoritative for entry_count, registry resolution, arithmetic, one-decimal precision, deterministic ordering, dense ranks, and bounded transport partitioning."
}
