{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leaderboard-dataset.schema.json",
  "title": "Local Inference Test Bench leaderboard dataset",
  "description": "The deterministic logical dataset built from accepted submissions, including an explicit retained-1.0 migration branch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entry_count",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/legacyMonolithEntry"
            }
          }
        }
      },
      "else": {
        "properties": {
          "entries": {
            "items": {
              "$ref": "#/$defs/versionedEntry"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "legacyMonolithEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "submission_id",
        "suite_version",
        "profile",
        "hardware",
        "runtime",
        "model",
        "settings",
        "metrics"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "submission_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite_version": {
          "const": "1.0"
        },
        "profile": {
          "const": "standard"
        },
        "hardware": {
          "$ref": "hardware-descriptor.schema.json#/$defs/hardware"
        },
        "runtime": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtime"
        },
        "runtime_configuration": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtimeConfiguration"
        },
        "model": {
          "$ref": "leaderboard-submission-v1.0.schema.json#/$defs/model"
        },
        "settings": {
          "$ref": "leaderboard-submission-v1.0.schema.json#/$defs/settings"
        },
        "metrics": {
          "$ref": "#/$defs/legacyLeaderboardMetrics"
        }
      }
    },
    "versionedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "facet_id",
        "config_cell",
        "corroboration",
        "score_intervals",
        "performance_distribution",
        "plausibility",
        "submission_schema_version",
        "submission_id",
        "suite_version",
        "profile",
        "validity",
        "measurement_period",
        "measurement_conditions",
        "hardware",
        "runtime",
        "model",
        "settings",
        "metrics"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "facet_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "config_cell": {
          "$ref": "#/$defs/configCell"
        },
        "corroboration": {
          "$ref": "#/$defs/corroboration"
        },
        "score_intervals": {
          "$ref": "#/$defs/scoreIntervals"
        },
        "performance_distribution": {
          "$ref": "#/$defs/performanceDistribution"
        },
        "plausibility": {
          "$ref": "#/$defs/plausibility"
        },
        "submission_schema_version": {
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "submission_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "suite_version": {
          "$ref": "leaderboard-submission.schema.json#/$defs/suiteVersion"
        },
        "profile": {
          "$ref": "leaderboard-submission.schema.json#/$defs/profile"
        },
        "validity": {
          "enum": [
            "clean",
            "nonquiescent",
            "degraded_midrun",
            "legacy_unreported"
          ]
        },
        "measurement_period": {
          "oneOf": [
            {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementPeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "measurement_conditions": {
          "oneOf": [
            {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementConditions"
            },
            {
              "type": "null"
            }
          ]
        },
        "determinism": {
          "$ref": "leaderboard-submission.schema.json#/$defs/determinism"
        },
        "hardware": {
          "$ref": "hardware-descriptor.schema.json#/$defs/hardware"
        },
        "runtime": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtime"
        },
        "runtime_configuration": {
          "$ref": "hardware-descriptor.schema.json#/$defs/runtimeConfiguration"
        },
        "model": {
          "$ref": "leaderboard-submission.schema.json#/$defs/model"
        },
        "settings": {
          "$ref": "leaderboard-submission.schema.json#/$defs/settings"
        },
        "metrics": {
          "$ref": "#/$defs/leaderboardMetrics"
        }
      },
      "oneOf": [
        {
          "properties": {
            "submission_schema_version": {
              "const": "1.0"
            },
            "suite_version": {
              "const": "1.0"
            },
            "profile": {
              "const": "standard"
            },
            "validity": {
              "const": "legacy_unreported"
            },
            "measurement_period": {
              "type": "null"
            },
            "measurement_conditions": {
              "type": "null"
            }
          },
          "not": {
            "required": [
              "determinism"
            ]
          }
        },
        {
          "properties": {
            "submission_schema_version": {
              "const": "1.1"
            },
            "validity": {
              "$ref": "leaderboard-submission.schema.json#/$defs/publicValidity"
            },
            "measurement_period": {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementPeriod"
            },
            "measurement_conditions": {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementConditions"
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "profile": {
                "const": "standard"
              },
              "suite_version": {
                "const": "1.0"
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "metrics": {
                  "properties": {
                    "case_count": {
                      "const": 5
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "metrics": {
                  "properties": {
                    "latency_ms_mean": {
                      "type": "number"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "metrics": {
                  "properties": {
                    "usage_coverage_cases": {
                      "const": 0
                    },
                    "latency_ms_mean": {
                      "type": "null"
                    },
                    "completion_tokens_per_second": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "configCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_version",
        "selection_version",
        "digest"
      ],
      "properties": {
        "key_version": {
          "const": "1.0"
        },
        "selection_version": {
          "const": "1.0"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validityCorroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "earliest_period",
        "latest_period"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "earliest_period": {
          "oneOf": [
            {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementPeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_period": {
          "oneOf": [
            {
              "$ref": "leaderboard-submission.schema.json#/$defs/measurementPeriod"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "corroboration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_record_count",
        "by_validity"
      ],
      "properties": {
        "accepted_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "by_validity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clean",
            "nonquiescent",
            "degraded_midrun",
            "legacy_unreported"
          ],
          "properties": {
            "clean": {
              "$ref": "#/$defs/validityCorroboration"
            },
            "nonquiescent": {
              "$ref": "#/$defs/validityCorroboration"
            },
            "degraded_midrun": {
              "$ref": "#/$defs/validityCorroboration"
            },
            "legacy_unreported": {
              "$ref": "#/$defs/validityCorroboration"
            }
          }
        }
      }
    },
    "wilsonInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lower_percent",
        "upper_percent"
      ],
      "properties": {
        "lower_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "upper_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "scoreIntervals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "semantic",
        "exact_format"
      ],
      "properties": {
        "method": {
          "const": "wilson_95"
        },
        "semantic": {
          "$ref": "#/$defs/wilsonInterval"
        },
        "exact_format": {
          "$ref": "#/$defs/wilsonInterval"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "median",
        "minimum",
        "maximum"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000
        },
        "minimum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000
        },
        "maximum": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "performanceDistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latency_ms_mean",
        "completion_tokens_per_second"
      ],
      "properties": {
        "latency_ms_mean": {
          "$ref": "#/$defs/distribution"
        },
        "completion_tokens_per_second": {
          "$ref": "#/$defs/distribution"
        }
      }
    },
    "plausibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "status",
        "basis",
        "evaluated_record_count",
        "outside_envelope_record_count",
        "signals"
      ],
      "properties": {
        "policy_version": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "within_envelope",
            "caution",
            "not_evaluated"
          ]
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hardware_class",
            "model_size_bucket",
            "model_size_basis"
          ],
          "properties": {
            "hardware_class": {
              "enum": [
                "cpu_only",
                "shared_accelerator",
                "discrete_accelerator",
                "mixed_accelerator",
                "unknown"
              ]
            },
            "model_size_bucket": {
              "enum": [
                "under_4b",
                "4b_to_under_14b",
                "14b_to_under_35b",
                "35b_to_under_70b",
                "70b_and_above",
                "unknown"
              ]
            },
            "model_size_basis": {
              "enum": [
                "active_billions",
                "total_billions",
                "unknown"
              ]
            }
          }
        },
        "evaluated_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "outside_envelope_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "signals": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "latency_below_envelope",
              "throughput_above_envelope"
            ]
          }
        }
      }
    },
    "legacyLeaderboardMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "semantic_pass_count",
        "exact_format_pass_count",
        "scored_case_count",
        "usage_coverage_cases",
        "latency_ms_mean",
        "completion_tokens_per_second",
        "semantic_score_percent",
        "exact_format_score_percent"
      ],
      "properties": {
        "case_count": {
          "const": 5
        },
        "semantic_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "exact_format_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scored_case_count": {
          "const": 5
        },
        "usage_coverage_cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "latency_ms_mean": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000000
        },
        "completion_tokens_per_second": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "exact_format_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "completion_tokens_per_second": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "usage_coverage_cases": {
                "const": 5
              }
            }
          }
        }
      ]
    },
    "leaderboardMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "semantic_pass_count",
        "exact_format_pass_count",
        "scored_case_count",
        "usage_coverage_cases",
        "latency_ms_mean",
        "completion_tokens_per_second",
        "semantic_score_percent",
        "exact_format_score_percent"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "semantic_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "exact_format_pass_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "scored_case_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "usage_coverage_cases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "latency_ms_mean": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "completion_tokens_per_second": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "exact_format_score_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "latency_ms_mean": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "usage_coverage_cases": {
                "const": 0
              },
              "completion_tokens_per_second": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "$comment": "The logical 1.0 branch preserves the original unannotated monolith byte contract. A logical 1.1 dataset projects one bounded config cell with one score-neutral representative. Python and browser validators enforce config/corroboration arithmetic, representative Wilson bounds, distributions, plausibility relationships, deterministic transitive rank bands, registry resolution, numeric precision, and bounded transport partitioning. Original digest-named accepted records remain the append-only source of truth."
}
