{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement-evidence.schema.json",
  "title": "Local Inference Test Bench categorical measurement evidence",
  "description": "An ignored, owner-only local handoff carrying only categorical quiescence and optional determinism evidence for public result preparation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_run_id",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_run_id": {
      "$ref": "#/$defs/sourceRunId"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/modelEvidence"
      }
    }
  },
  "$defs": {
    "sourceRunId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u200E\\u200F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069\\uD800-\\uDFFF]+$"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u200E\\u200F\\u2028\\u2029\\u202A-\\u202E\\u2066-\\u2069\\uD800-\\uDFFF]+$"
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "validity",
        "measurement_conditions"
      ],
      "properties": {
        "model_id": {
          "$ref": "#/$defs/modelId"
        },
        "validity": {
          "$ref": "leaderboard-submission.schema.json#/$defs/publicValidity"
        },
        "measurement_conditions": {
          "$ref": "leaderboard-submission.schema.json#/$defs/measurementConditions"
        },
        "determinism": {
          "$ref": "leaderboard-submission.schema.json#/$defs/determinism"
        }
      }
    }
  },
  "$comment": "The Python loader additionally requires a regular owner-only Git-ignored file, rejects duplicate model_id values, checks categorical validity, checks that semantic_pass_rate is arithmetically possible for n_runs, checks determinism verdict consistency, and applies the public-data deny walker. This contract contains no raw threshold values, prompts, completions, host inventory, endpoints, or credentials."
}
